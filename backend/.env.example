NODE_ENV=development
PORT=3333
DATABASE_URL="file:./dev.db"
CORS_ORIGIN="http://localhost:5173"

# Simulador do webhook externo instável (usado para demonstrar o Retry/backoff)
# WEBHOOK_SUCCESS_RATE: probabilidade (0 a 1) de sucesso em cada tentativa
# WEBHOOK_MIN_LATENCY_MS / WEBHOOK_MAX_LATENCY_MS: latência simulada da chamada externa
WEBHOOK_SUCCESS_RATE=0.5
WEBHOOK_MIN_LATENCY_MS=200
WEBHOOK_MAX_LATENCY_MS=800

# Engine de retry: numero maximo de tentativas e delay base (ms) do exponential backoff
AUTOMATION_MAX_RETRIES=3
AUTOMATION_BASE_DELAY_MS=1000
